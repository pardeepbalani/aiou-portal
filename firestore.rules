rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net - deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // ID verification to allow standard document ID strings
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 256;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Flexible validation function representing the StudentRecord schema
    function isValidStudentRecord(data) {
      return data.id is string
        && (!('studentName' in data) || data.studentName is string)
        && (!('fatherName' in data) || data.fatherName is string)
        && (!('phoneNumber' in data) || data.phoneNumber is string)
        && (!('registrationId' in data) || data.registrationId is string)
        && (!('lmsPasswordId' in data) || data.lmsPasswordId is string)
        && (!('cmsPasswordId' in data) || data.cmsPasswordId is string)
        && (!('admissionYear' in data) || data.admissionYear is string)
        && (!('programSelected' in data) || data.programSelected is string)
        && (!('programCategory' in data) || data.programCategory is string)
        && (!('isDeleted' in data) || data.isDeleted is bool)
        && (!('semesterType' in data) || data.semesterType is string)
        && (!('semesters' in data) || data.semesters is list)
        && (!('totalReceivable' in data) || data.totalReceivable is int || data.totalReceivable is float)
        && (!('paymentsList' in data) || data.paymentsList is list)
        && (!('serviceChargesAmount' in data) || data.serviceChargesAmount is int || data.serviceChargesAmount is float)
        && (!('remarks' in data) || data.remarks is string)
        && (!('serviceEnrollment' in data) || data.serviceEnrollment is bool)
        && (!('serviceWorkshops' in data) || data.serviceWorkshops is bool)
        && (!('serviceQuiz' in data) || data.serviceQuiz is bool)
        && (!('serviceAssignments' in data) || data.serviceAssignments is bool)
        && (!('servicePhysicalWorkshop' in data) || data.servicePhysicalWorkshop is bool)
        && (!('serviceResearchReport' in data) || data.serviceResearchReport is bool)
        && (!('status' in data) || data.status is string)
        && (!('createdAt' in data) || data.createdAt is string)
        && (!('updatedAt' in data) || data.updatedAt is string);
    }

    // Flexible validation functions to allow smooth schema variations across devices
    function isValidExamManager(data) {
      return data.id is string;
    }

    function isValidExamManagerPaymentRecord(data) {
      return data.id is string;
    }

    function isValidStudentExamInfo(data) {
      return data.id is string;
    }

    function isValidStudentDegreeRecord(data) {
      return data.id is string;
    }

    function isValidStudentQuizRecord(data) {
      return data.id is string;
    }

    function isValidResearchProjectRecord(data) {
      return data.id is string;
    }

    function isValidF2FManager(data) {
      return data.id is string;
    }

    function isValidF2FCandidateRecord(data) {
      return data.id is string;
    }

    function isValidF2FManagerPaymentRecord(data) {
      return data.id is string;
    }

    // Rules for students_records collection
    match /students_records/{studentId} {
      // Public read operations are allowed with ID validation
      allow get: if isValidId(studentId);
      allow list: if true;

      // Create operations are validated against ID structure and Schema structure
      allow create: if isValidId(studentId)
        && incoming().id == studentId
        && isValidStudentRecord(incoming());

      // Update operations are validated against ID structure and Schema structure
      allow update: if isValidId(studentId)
        && incoming().id == existing().id
        && isValidStudentRecord(incoming());

      // Delete operations are protected with ID validation
      allow delete: if isValidId(studentId);
    }

    // Rules for exam_managers collection
    match /exam_managers/{managerId} {
      allow get: if isValidId(managerId);
      allow list: if true;

      allow create: if isValidId(managerId)
        && incoming().id == managerId
        && isValidExamManager(incoming());

      allow update: if isValidId(managerId)
        && incoming().id == existing().id
        && isValidExamManager(incoming());

      allow delete: if isValidId(managerId);
    }

    // Rules for exam_manager_payments collection
    match /exam_manager_payments/{recordId} {
      allow get: if isValidId(recordId);
      allow list: if true;

      allow create: if isValidId(recordId)
        && incoming().id == recordId
        && isValidExamManagerPaymentRecord(incoming());

      allow update: if isValidId(recordId)
        && incoming().id == existing().id
        && isValidExamManagerPaymentRecord(incoming());

      allow delete: if isValidId(recordId);
    }

    // Rules for exam_records collection
    match /exam_records/{recordId} {
      allow get: if isValidId(recordId);
      allow list: if true;

      allow create: if isValidId(recordId)
        && incoming().id == recordId
        && isValidStudentExamInfo(incoming());

      allow update: if isValidId(recordId)
        && incoming().id == existing().id
        && isValidStudentExamInfo(incoming());

      allow delete: if isValidId(recordId);
    }

    // Rules for degree_records collection
    match /degree_records/{recordId} {
      allow get: if isValidId(recordId);
      allow list: if true;

      allow create: if isValidId(recordId)
        && incoming().id == recordId
        && isValidStudentDegreeRecord(incoming());

      allow update: if isValidId(recordId)
        && incoming().id == existing().id
        && isValidStudentDegreeRecord(incoming());

      allow delete: if isValidId(recordId);
    }

    // Rules for quiz_records collection
    match /quiz_records/{recordId} {
      allow get: if isValidId(recordId);
      allow list: if true;

      allow create: if isValidId(recordId)
        && incoming().id == recordId
        && isValidStudentQuizRecord(incoming());

      allow update: if isValidId(recordId)
        && incoming().id == existing().id
        && isValidStudentQuizRecord(incoming());

      allow delete: if isValidId(recordId);
    }

    // Rules for research_project_records collection
    match /research_project_records/{recordId} {
      allow get: if isValidId(recordId);
      allow list: if true;

      allow create: if isValidId(recordId)
        && incoming().id == recordId
        && isValidResearchProjectRecord(incoming());

      allow update: if isValidId(recordId)
        && incoming().id == existing().id
        && isValidResearchProjectRecord(incoming());

      allow delete: if isValidId(recordId);
    }

    // Rules for f2f_managers collection
    match /f2f_managers/{managerId} {
      allow get: if isValidId(managerId);
      allow list: if true;

      allow create: if isValidId(managerId)
        && incoming().id == managerId
        && isValidF2FManager(incoming());

      allow update: if isValidId(managerId)
        && incoming().id == existing().id
        && isValidF2FManager(incoming());

      allow delete: if isValidId(managerId);
    }

    // Rules for f2f_candidates collection
    match /f2f_candidates/{recordId} {
      allow get: if isValidId(recordId);
      allow list: if true;

      allow create: if isValidId(recordId)
        && incoming().id == recordId
        && isValidF2FCandidateRecord(incoming());

      allow update: if isValidId(recordId)
        && incoming().id == existing().id
        && isValidF2FCandidateRecord(incoming());

      allow delete: if isValidId(recordId);
    }

    // Rules for f2f_manager_payments collection
    match /f2f_manager_payments/{recordId} {
      allow get: if isValidId(recordId);
      allow list: if true;

      allow create: if isValidId(recordId)
        && incoming().id == recordId
        && isValidF2FManagerPaymentRecord(incoming());

      allow update: if isValidId(recordId)
        && incoming().id == existing().id
        && isValidF2FManagerPaymentRecord(incoming());

      allow delete: if isValidId(recordId);
    }
  }
}
